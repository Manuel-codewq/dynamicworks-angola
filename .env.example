# ── Base de dados (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Autenticação (NextAuth) ───────────────────────────────────────────────────
AUTH_SECRET="gere-com: openssl rand -base64 32"
AUTH_URL="https://dynamicworks.ao"
NEXTAUTH_SECRET="igual ao AUTH_SECRET"
NEXTAUTH_URL="https://dynamicworks.ao"
JWT_SECRET="gere-com: openssl rand -base64 32"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Cloudinary (uploads KYC / avatares) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY="Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_EMAIL="mailto:suporte@dynamicworks.ao"

# ── Cloudflare Turnstile (bot protection) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x000000000000000000000000"
TURNSTILE_SECRET_KEY="0x000000000000000000000000000000000000"

# ── Workers / Cron ────────────────────────────────────────────────────────────
WORKER_SECRET="gere-com: openssl rand -hex 32"
CRON_SECRET="gere-com: openssl rand -hex 32"

# ── IA (Anthropic / Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Taxa BNA (pode ser valor fixo ou atualizado via cron) ────────────────────
BNA_USD_RATE="950"
