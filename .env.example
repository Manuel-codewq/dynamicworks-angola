# ── Base de dados (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Autenticação (NextAuth) ───────────────────────────────────────────────────
AUTH_SECRET="gere-com: openssl rand -base64 32"
AUTH_URL="https://dynamicworks.ao"
NEXTAUTH_SECRET="igual ao AUTH_SECRET"
NEXTAUTH_URL="https://dynamicworks.ao"
JWT_SECRET="gere-com: openssl rand -base64 32"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Cloudinary (uploads KYC / avatares) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY="Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_EMAIL="mailto:suporte@dynamicworks.ao"

# ── Cloudflare Turnstile (bot protection) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x000000000000000000000000"
TURNSTILE_SECRET_KEY="0x000000000000000000000000000000000000"

# ── Workers / Cron ────────────────────────────────────────────────────────────
WORKER_SECRET="gere-com: openssl rand -hex 32"
CRON_SECRET="gere-com: openssl rand -hex 32"

# ── IA (Anthropic / Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Taxa BNA (pode ser valor fixo ou atualizado via cron) ────────────────────
BNA_USD_RATE="950"

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="um-token-secreto-que-tu-defines"
WHATSAPP_APP_SECRET="app secret da app Meta, usado para validar X-Hub-Signature-256"

# ── Evolution API (WhatsApp self-hosted) ──────────────────────────────────────
EVOLUTION_API_URL="https://evolution-api-production-59ec.up.railway.app"
EVOLUTION_API_KEY="DynamicWorks2025@API"
EVOLUTION_INSTANCE="DynamicWorks"
EVOLUTION_WEBHOOK_SECRET="gere-com: openssl rand -hex 32 — adiciona ?secret=<valor> à URL do webhook"

# ── synthetic-engine (fonte de preços — ver synthetic-engine/) ───────────────
# Local/dev: serviço a correr em npm run dev dentro de synthetic-engine/ (porta 4001 por omissão)
SYNTHETIC_ENGINE_URL="http://localhost:4001"
