# connection_limit=10&pool_timeout=20 — o pool por omissão do Prisma (5
# ligações) esgota-se com a carga normal deste serviço: 4 índices a fazer
# tick a cada 1s (tickEngine.ts) + candleAggregator.ts a cada 30s + pedidos
# normais da API, tudo a competir pelo mesmo pool. Mantém estes parâmetros
# ao preencher a connection string real.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&connection_limit=10&pool_timeout=20"
PORT=4001
