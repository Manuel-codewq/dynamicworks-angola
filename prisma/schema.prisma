generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                  @id @default(cuid())
  name              String
  email             String                  @unique
  password          String
  phone             String?
  province          String?
  biNumber          String?
  balance           Float                   @default(0)
  demoBalance       Float                   @default(10000)
  isDemo            Boolean                 @default(true)
  role              String                  @default("user")
  status            String                  @default("active")
  kycStatus         String                  @default("none")
  createdAt         DateTime                @default(now())
  emailVerified     Boolean                 @default(false)
  verifyCode        String?
  verifyExpires     DateTime?
  otpCode           String?
  otpExpires        DateTime?
  indicatorPrefs    Json?
  kycAttempts       Int                     @default(0)
  kycBlockedUntil   DateTime?
  avatar            String?
  lastSeenAt        DateTime?
  pwdOtpCode        String?
  pwdOtpExpires     DateTime?
  twoFaCode         String?
  twoFaExpires      DateTime?
  twoFactorEnabled  Boolean                 @default(false)
  twoFactorMethod   String?
  twoFactorSecret   String?
  referralCode      String?                 @unique
  referralEarnings  Float                   @default(0)
  referredBy        String?
  nifNumero         String?                 @unique
  nomeOficial       String?
  kycNifValidado    Boolean                 @default(false)
  dataNasc          String?
  genero            String?
  naturalidade      String?
  accessLogs        AccessLog[]
  copyFollowing     CopyFollow[]            @relation("CopyFollower")
  copyTrader        CopyTrader?
  kycSubmission     KycSubmission?
  notifications     Notification[]
  priceAlerts       PriceAlert[]
  pushSubscriptions PushSubscription[]
  supportTickets    SupportTicket[]
  tournaments       TournamentParticipant[]
  trades            Trade[]
  transactions      Transaction[]
  sessions          UserSession[]
}

model NifCache {
  nif       String   @id
  nome      String
  valid     Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  ip           String?
  userAgent    String?
  device       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  ip        String?
  userAgent String?
  action    String
  country   String?
  city      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id                      String    @id @default(cuid())
  userId                  String
  asset                   String
  direction               String
  amount                  Float
  entryPrice              Float
  closePrice              Float?
  payout                  Float     @default(0.85)
  result                  String?
  profit                  Float?
  expirySecs              Int
  status                  String    @default("active")
  createdAt               DateTime  @default(now())
  closedAt                DateTime?
  isDemo                  Boolean   @default(false)
  expiresAt               DateTime?
  tournamentParticipantId String?
  symbol                  String?
  user                    User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  method      String?
  status      String   @default("pending")
  reference   String?
  createdAt   DateTime @default(now())
  usdtAddress String?
  usdtAmount  Float?
  usdtRate    Float?
  usdtTxid    String?  @unique
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([method, status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Settings {
  id                       String    @id @default("singleton")
  otcMode                  String    @default("auto")
  maintenanceMode          Boolean   @default(false)
  winProbability           Json      @default("{}")
  payout                   Json      @default("{}")
  updatedAt                DateTime  @updatedAt
  activePairs              Json      @default("[]")
  rankingResetAt           DateTime?
  usdtMinDeposit           Float     @default(5)
  usdtRateAoa              Float     @default(0)
  usdtWallet               String?
  weekendPairs             Json      @default("[]")
  forceRealMarket          Boolean   @default(false)
  dailyLossLimitPct        Float     @default(0)
  largeTradePushThreshold  Float     @default(0)
  largeWithdrawalThreshold Float     @default(0)
}

model PriceCandle {
  id        String   @id @default(cuid())
  asset     String
  timeframe String
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([asset, timeframe, timestamp])
  @@index([asset, timeframe, timestamp])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  subject   String
  category  String           @default("outro")
  status    String           @default("open")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  body      String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}


model KycSubmission {
  id            String   @id @default(cuid())
  userId        String   @unique
  faceFront     String
  faceRight     String
  faceLeft      String
  biFront       String
  biBack        String
  createdAt     DateTime @default(now())
  livenessScore Float    @default(0)
  user          User     @relation(fields: [userId], references: [id])
}

model Tournament {
  id              String                  @id @default(cuid())
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  prizePool       Float                   @default(0)
  prizes          Json                    @default("[]")
  status          String                  @default("upcoming")
  createdAt       DateTime                @default(now())
  bannerColor     String                  @default("#f5a623")
  entryFee        Float                   @default(0)
  isFree          Boolean                 @default(true)
  maxParticipants Int?
  rules           String?
  isDemo          Boolean                 @default(false)
  startingBalance Float                   @default(10000)
  participants    TournamentParticipant[]

  @@index([status, startDate])
}

model TournamentParticipant {
  id                String     @id @default(cuid())
  tournamentId      String
  userId            String
  profit            Float      @default(0)
  trades            Int        @default(0)
  wins              Int        @default(0)
  joinedAt          DateTime   @default(now())
  tournamentBalance Float      @default(10000)
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId, profit])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

model MarketPrice {
  symbol    String   @id
  price     Float
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id          String            @id @default(cuid())
  code        String            @unique
  type        String            @default("balance")
  value       Float
  maxUses     Int               @default(1)
  usedCount   Int               @default(0)
  expiresAt   DateTime?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([promoCodeId, userId])
  @@index([userId])
}

model CopyTrader {
  id             String       @id @default(cuid())
  userId         String       @unique
  status         String       @default("pending")
  bio            String?
  commission     Float        @default(0.10)
  totalFollowers Int          @default(0)
  totalCopied    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  followers      CopyFollow[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CopyFollow {
  id         String     @id @default(cuid())
  followerId String
  traderId   String
  amount     Float      @default(1000)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  follower   User       @relation("CopyFollower", fields: [followerId], references: [id], onDelete: Cascade)
  trader     CopyTrader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([followerId, traderId])
  @@index([traderId, active])
}

model PriceAlert {
  id        String   @id @default(cuid())
  userId    String
  asset     String
  price     Float
  direction String
  triggered Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([triggered])
}
